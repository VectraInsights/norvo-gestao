# Copie para .env e preencha. NUNCA commite o .env real.
# Ambiente fiscal de testes: NF-e, CT-e e MDF-e são fixados em homologação/tpAmb=2 no runtime.
# Não adicione MDFE/NFE/CTE_AMBIENTE para reativar produção enquanto o sistema estiver em testes.
# Chaves publicáveis (anon/publishable) podem ficar na Vercel também.
SUPABASE_PROJECT_ID="seu-project-ref"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://seu-project-ref.supabase.co"

VITE_SUPABASE_PROJECT_ID="seu-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://seu-project-ref.supabase.co"

# SECRET - server-side apenas (client.server.ts / admin). Configurar na Vercel como env var.
# Obter em: Supabase Dashboard -> Project Settings -> API Keys -> Secret key
SUPABASE_SERVICE_ROLE_KEY=""
