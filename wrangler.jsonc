  "vars": {
    "VITE_SUPABASE_URL": "https://lfxhimtbuazezjkjlddj.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_DHkWhHGR_Lzb1hlGy5JUKQ_xiDIqxd1",
    "VITE_SEFAZ_URL": "https://norvo-gestao.vercel.app/api/sefaz",
    "SUPABASE_URL": "https://lfxhimtbuazezjkjlddj.supabase.co",
